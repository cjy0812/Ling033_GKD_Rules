{
  "name": "gkd-rules-subscription",
  "version": "0.0.0",
  "type": "module",
  "gkd": {
    "outDir": "dist",
    "file": "gkd.json5",
    "versionFile": "gkd.version.json5",
    "changelog": "CHANGELOG.md",
    "README.md": "README.md"
  },
  "scripts": {
    "postinstall": "simple-git-hooks",
    "format": "biome format --write",
    "lint": "biome check --write",
    "check": "tsc --noEmit -p tsconfig.json && tsx ./scripts/check.ts",
    "build": "tsc --noEmit -p tsconfig.json && tsx ./scripts/build.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "pre-push": "pnpm run check"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,jsx,tsx,json,jsonc}": [
      "biome check --write"
    ]
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "./dist"
  ],
  "dependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/types": "21.2.3",
    "@gkd-kit/api": "0.9.3",
    "@gkd-kit/define": "0.0.1",
    "@gkd-kit/tools": "0.8.0",
    "@types/node": "26.6.3",
    "json5": "2.2.3",
    "lint-staged": "17.6.0",
    "simple-git-hooks": "2.14.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "volta": {
    "node": "24.21.0",
    "pnpm": "10.22.0"
  },
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26",
  "engineStrict": true,
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15"
  }
}
